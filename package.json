{
  "name": "neon-fare-arcade",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "install:ci": "bash scripts/install-ci.sh",
    "dev": "vite",
    "build": "node scripts/platform-task.mjs build",
    "start": "vinext start",
    "test": "npm run test:architecture && npm run test:runtime && npm run test:unit && npm run build && node --test tests/rendered-html.test.mjs",
    "test:architecture": "node --test tests/architecture.test.mjs",
    "test:runtime": "node --import tsx --test tests/runtime/*.test.ts",
    "test:browser": "playwright test",
    "test:browser:headed": "playwright test --headed",
    "test:file": "node --import tsx --test",
    "test:core": "node scripts/run-game-tests.mjs fast",
    "test:world": "node scripts/run-game-tests.mjs exhaustive",
    "test:unit": "node scripts/run-game-tests.mjs all",
    "typecheck": "tsc --noEmit --incremental false --pretty false",
    "check:fast": "npm run lint && npm run typecheck && npm run test:architecture && npm run test:runtime && npm run test:core",
    "check": "npm run lint && npm run typecheck && npm test",
    "validate:artifact": "node scripts/platform-task.mjs validate",
    "lint": "node scripts/platform-task.mjs lint"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "next": "16.2.6",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "esbuild": "0.28.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.8",
    "tailwindcss": "4.2.1",
    "tsx": "4.22.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.16",
    "wrangler": "4.92.0"
  },
  "type": "module",
  "displayName": "Neon Fare"
}
